#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_common.sh"

init_infrastructure

echo "📱 Iniciando Bot de WhatsApp (entorno local con Redis)..."

docker compose up -d redis
docker compose build whatsapp-local

docker rm -f whatsapp-service whatsapp-bot 2>/dev/null || true

docker compose run --rm --name whatsapp-service \
  -e INTERFACE=${INTERFACE:-baileys} \
  -e FLOW_FILE=${FLOW_FILE:-flow_cfp412.json} \
  -e LEADS_STORAGE_TYPE=${LEADS_STORAGE_TYPE:-csv} \
  -e AUTH_STORAGE_TYPE=${AUTH_STORAGE_TYPE:-redis} \
  whatsapp-local
