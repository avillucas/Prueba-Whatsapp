#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_common.sh"

init_infrastructure

echo "🚀 Iniciando despliegue de WhatsApp Bot con Firebase (Firestore) y Google Sheets..."

echo "📦 Construyendo la imagen Docker para whatsapp-firebase..."
docker compose build whatsapp-firebase

if [ "$(docker ps -aq -f name=whatsapp-firebase)" ]; then
    echo "🛑 Deteniendo y removiendo contenedor anterior whatsapp-firebase..."
    docker rm -f whatsapp-firebase 2>/dev/null || true
fi

echo "🚀 Levantando contenedor whatsapp-firebase en modo interactivo..."
echo "💡 Escanea el código QR y observa la sincronización con Firebase en pantalla."
echo "----------------------------------------------------------------------"

docker compose run --rm --name whatsapp-firebase whatsapp-firebase

