#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_common.sh"

init_infrastructure

echo "🖥️ Iniciando CLI interactiva del Motor de Decisiones..."

docker compose build whatsapp-cli
docker rm -f cli-bot whatsapp-cli 2>/dev/null || true

docker compose run --rm --name cli-bot \
  -e INTERFACE=${INTERFACE:-command} \
  -e FLOW_FILE=${FLOW_FILE:-flow_cfp412.json} \
  -e LEADS_STORAGE_TYPE=${LEADS_STORAGE_TYPE:-csv} \
  whatsapp-cli
