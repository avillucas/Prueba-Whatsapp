#!/bin/bash
set -e

echo "🚀 Iniciando Bot de WhatsApp con integración a Google Sheets..."

# Asegurarse de que los directorios requeridos existan
mkdir -p auth_info data flows

# Construimos la imagen si no existe
docker compose build whatsapp-bot

# Si existe un archivo .env, pasamos la referencia; si no, cargamos las variables inline.
ENV_FILE_FLAG=""
if [ -f ".env" ]; then
    ENV_FILE_FLAG="--env-file .env"
fi

# Ejecutamos el contenedor temporal con las variables sobreescritas para Google Sheets
docker compose $ENV_FILE_FLAG run --rm \
  --name cli-googlesheet \
  -e INTERFACE=${INTERFACE:-command} \
  -e FLOW_FILE=${FLOW_FILE:-flow_cfp412.json} \
  -e LEADS_STORAGE_TYPE=google_sheets \
  whatsapp-bot
