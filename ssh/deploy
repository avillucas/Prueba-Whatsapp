#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_common.sh"

init_infrastructure

echo "🚀 Iniciando despliegue de producción del WhatsApp Bot (Docker Compose)..."

echo "📦 Construyendo la imagen Docker para whatsapp-firebase..."
docker compose build whatsapp-firebase

if [ "$(docker ps -aq -f name=whatsapp-firebase)" ]; then
    echo "🛑 Deteniendo contenedor anterior whatsapp-firebase..."
    docker compose stop whatsapp-firebase 2>/dev/null || true
    docker compose rm -f whatsapp-firebase 2>/dev/null || true
fi

echo "🚀 Levantando contenedor de producción..."
docker compose up -d whatsapp-firebase

echo "✅ Despliegue de producción completado con éxito."
echo "💡 Para ver los logs y escanear el QR ejecuta: docker compose logs -f whatsapp-firebase"
