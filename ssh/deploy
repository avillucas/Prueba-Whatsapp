#!/bin/bash
set -e

# Exportar rutas estándar para garantizar disponibilidad de Docker en sesiones SSH no interactivas
export PATH=$PATH:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/snap/bin

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_common.sh"

if ! command -v docker &> /dev/null; then
    echo "❌ Error: 'docker' no se encuentra en el PATH o no está instalado en el servidor remoto."
    echo "💡 Pasos para solucionar en el servidor de GCP:"
    echo "   1. Instalar Docker Engine & Docker Compose V2:"
    echo "      curl -fsSL https://get.docker.com -o get-docker.sh && sudo sh get-docker.sh"
    echo "   2. Agregar el usuario SSH al grupo docker:"
    echo "      sudo usermod -aG docker \$USER"
    echo "   3. Reiniciar la sesión SSH o recargar el grupo con: newgrp docker"
    exit 127
fi

init_infrastructure

echo "🚀 Iniciando despliegue de producción del WhatsApp Bot (Docker Compose)..."

echo "📦 Construyendo la imagen Docker para whatsapp-firestore..."
docker compose build whatsapp-firestore

if [ "$(docker ps -aq -f name=whatsapp-firestore)" ]; then
    echo "🛑 Deteniendo contenedor anterior whatsapp-firestore..."
    docker compose stop whatsapp-firestore 2>/dev/null || true
    docker compose rm -f whatsapp-firestore 2>/dev/null || true
fi

echo "🚀 Levantando contenedor de producción..."
docker compose up -d whatsapp-firestore

echo "✅ Despliegue de producción completado con éxito."
echo "💡 Para ver los logs y escanear el QR ejecuta: docker compose logs -f whatsapp-firestore"

