#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_common.sh"

init_infrastructure

echo "🚀 Iniciando Bot de WhatsApp con almacenamiento NoSQL..."

docker compose up -d redis
docker compose build whatsapp-local

docker rm -f whatsapp-storage 2>/dev/null || true

docker compose run --rm -it \
  --name whatsapp-storage \
  -e INTERFACE=${INTERFACE:-baileys} \
  -e FLOW_FILE=${FLOW_FILE:-flow_cfp412.json} \
  -e AUTH_STORAGE_TYPE=${AUTH_STORAGE_TYPE:-firestore} \
  -e REDIS_HOST=redis \
  -e REDIS_PORT=6379 \
  whatsapp-local
